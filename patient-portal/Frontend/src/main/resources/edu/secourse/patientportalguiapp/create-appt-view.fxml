<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.secourse.patientportalguiapp.controllers.CreateAppointmentController">
    <children>
        <Label alignment="TOP_CENTER" text="Create a appointment" textFill="#309423">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <Label fx:id="actionText" textFill="#1b2e90">
            <font>
                <Font size="15.0" />
            </font></Label>
        <GridPane alignment="CENTER" hgap="10.0" vgap="20.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" />
                <ColumnConstraints halignment="LEFT" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Date" GridPane.columnIndex="0" GridPane.rowIndex="0">
                   <font>
                      <Font size="16.0" />
                   </font>
                </Label>
                <DatePicker fx:id="appointmentDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Start Time" GridPane.rowIndex="1">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <children>
                        <Spinner fx:id="startHourSpinner" prefWidth="70"/>
                        <Label text=":"/>
                        <Spinner fx:id="startMinuteSpinner" prefWidth="70"/>
                    </children>
                </HBox>
                <Label text="End Time" GridPane.rowIndex="2">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>

                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <children>
                        <Spinner fx:id="endHourSpinner" prefWidth="70"/>
                        <Label text=":"/>
                        <Spinner fx:id="endMinuteSpinner" prefWidth="70"/>
                    </children>
                </HBox>
                <Label text="Patient Id" GridPane.rowIndex="3">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
                <TextField fx:id="patientIdField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label text="Doctor Id" GridPane.rowIndex="4">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
                <TextField fx:id="doctorIdField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </children>
            <VBox.margin>
                <Insets top="50.0" />
            </VBox.margin>
        </GridPane>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="backButton" onAction="#onBackButtonClick" text="Back" />
                <Region prefWidth="20" />
                <Button fx:id="createAppointmentButton" onAction="#onCreateAppointmentButtonClick" text="Create Appointment" />
            </children>
            <VBox.margin>
                <Insets top="30" />
            </VBox.margin>
        </HBox>

    </children>
</VBox>
