<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="400.0"
      maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.HamesJoman.patientportalguiapp.controllers.AdminControllers.SearchApptByPatientController">
    <padding>
        <Insets top="15.0" />
    </padding>
    <children>
        <Label alignment="TOP_CENTER" text="Search Appointments by Patient" textFill="#309423">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Label text="Select Patient:">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <ComboBox fx:id="patientSelectComboBox" prefWidth="240.0" />
            </children>
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
        </HBox>
        <TextArea fx:id="outputBox" prefHeight="200.0" prefWidth="350.0" wrapText="true" editable="false">
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
        </TextArea>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="backButton" text="Back" onAction="#onBackButtonClick" />
            </children>
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
