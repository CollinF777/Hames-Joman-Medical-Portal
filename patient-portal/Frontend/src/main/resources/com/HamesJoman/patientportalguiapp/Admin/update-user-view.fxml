<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="480.0" prefWidth="420.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.HamesJoman.patientportalguiapp.controllers.AdminControllers.UpdateUserController">
    <padding>
        <Insets top="15.0" />
    </padding>
    <children>
        <Label text="Update User" textFill="#309423">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <Label fx:id="actionText" textFill="#1b2e90" wrapText="true">
            <font>
                <Font size="13.0" />
            </font>
        </Label>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Label text="Select User:">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <ComboBox fx:id="userSelectComboBox" prefWidth="240.0" />
            </children>
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
        </HBox>
        <Separator>
            <VBox.margin>
                <Insets top="15.0" bottom="5.0" left="20.0" right="20.0" />
            </VBox.margin>
        </Separator>
        <GridPane alignment="CENTER" hgap="10.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="90.0" />
                <ColumnConstraints halignment="LEFT" minWidth="180.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints prefHeight="30.0" />
                <RowConstraints prefHeight="30.0" />
                <RowConstraints prefHeight="30.0" />
                <RowConstraints prefHeight="30.0" />
                <RowConstraints prefHeight="30.0" />
            </rowConstraints>
            <children>
                <Label text="First Name:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="firstNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Last Name:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="lastNameField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="usernameField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="New Password:" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <PasswordField fx:id="passwordField" promptText="Leave blank to keep unchanged" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="4">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <ComboBox fx:id="roleComboBox" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="150.0" />
            </children>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </GridPane>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="backButton" text="Back" onAction="#onBackButtonClick" />
                <Region prefWidth="20.0" />
                <Button fx:id="updateButton" text="Update User" onAction="#onUpdateButtonClick" />
            </children>
            <VBox.margin>
                <Insets top="25.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
