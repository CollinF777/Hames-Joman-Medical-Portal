<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="615.0" prefWidth="701.0" spacing="20" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.HamesJoman.patientportalguiapp.controllers.DoctorControllers.DoctorController">
   <!-- ================= TOP HEADER ================= -->
   <HBox alignment="CENTER_LEFT" spacing="20">
      <padding>
         <Insets bottom="10" left="10" right="10" top="10" />
      </padding>
      <children>
         <Label fx:id="welcomeLabel" text="Welcome back!">
            <font>
               <Font size="28" />
            </font>
         </Label>

         <Region HBox.hgrow="ALWAYS" />
         <VBox prefHeight="52.0" prefWidth="150.0">
            <children>
               <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#onLogoutButtonClick" prefHeight="26.0" prefWidth="154.0" text="Log out" />
               <Button id="changePasswordButton" onAction="#onChangePasswordWindowOpen" mnemonicParsing="false" prefHeight="26.0" prefWidth="156.0" text="Change Password" />
            </children>
         </VBox>
      </children>
   </HBox>

   <!-- ================= STATS ROW ================= -->
   <HBox alignment="CENTER" prefHeight="40.0" prefWidth="604.0" spacing="40">
      <VBox prefHeight="40.0" prefWidth="371.0">
         <Label style="-fx-font-weight: bold; -fx-text-fill: gray;" text="Next Appointment" />
         <Label fx:id="nextApptLabel" prefHeight="22.0" prefWidth="457.0" style="-fx-font-size: 16px;" text="Loading..." />
      </VBox>

      <Separator orientation="VERTICAL" prefHeight="40.0" prefWidth="0.0" />

      <VBox alignment="TOP_RIGHT">
         <Label fx:id="totalApptsLabel" alignment="CENTER" prefHeight="61.0" prefWidth="186.0" style="-fx-font-size: 16px;" text="0 Total Appointments" textAlignment="RIGHT" />
      </VBox>
   </HBox>

   <!-- ================= FILTERS ================= -->
   <VBox spacing="8">
      <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Filters" />

      <HBox alignment="CENTER_LEFT" spacing="16">

         <!-- Date From -->
         <VBox spacing="4">
            <Label style="-fx-font-size: 12px; -fx-text-fill: gray;" text="From" />
            <DatePicker fx:id="filterFromDate" onAction="#onFiltersChanged" promptText="Min date" prefWidth="160.0" />
         </VBox>

         <!-- Date To -->
         <VBox spacing="4">
            <Label style="-fx-font-size: 12px; -fx-text-fill: gray;" text="To" />
            <DatePicker fx:id="filterToDate" onAction="#onFiltersChanged" promptText="Max date" prefWidth="160.0" />
         </VBox>

         <!-- Patient -->
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 12px; -fx-text-fill: gray;" text="Patient" />
            <ComboBox fx:id="filterPatientComboBox" onAction="#onFiltersChanged" promptText="All patients" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
         </VBox>

         <!-- Clear button -->
         <VBox alignment="BOTTOM_LEFT" spacing="4">
            <Label style="-fx-font-size: 12px; -fx-text-fill: transparent;" text="x" />
            <Button fx:id="clearFiltersButton" mnemonicParsing="false" onAction="#onClearFilters" prefHeight="26.0" prefWidth="80.0" text="Clear" />
         </VBox>

      </HBox>
   </VBox>

   <!-- ================= SCHEDULE LIST ================= -->
   <VBox spacing="10" VBox.vgrow="ALWAYS">
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Upcoming Schedule" />
      <ListView fx:id="appointmentListView" VBox.vgrow="ALWAYS" />
   </VBox>

   <padding>
      <Insets bottom="20" left="20" right="20" top="20" />
   </padding>
</VBox>
