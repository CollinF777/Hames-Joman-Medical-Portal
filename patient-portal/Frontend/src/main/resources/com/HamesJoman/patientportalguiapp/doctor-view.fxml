<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="615.0" prefWidth="638.0" spacing="20" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.HamesJoman.patientportalguiapp.controllers.DoctorControllers.DoctorController">
   <!-- ================= TOP HEADER ================= -->
      <HBox alignment="CENTER_LEFT" spacing="20">
         <padding>
            <Insets bottom="10" left="10" right="10" top="10" />
         </padding>
         <children>
            <Label fx:id="welcomeLabel" text="Welcome back!">
               <font>
                  <Font size="28" />
               </font>
            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#onLogoutButtonClick" text="Log out" />
         </children>
      </HBox>

   <HBox alignment="CENTER" spacing="40">
      <VBox>
         <Label style="-fx-font-weight: bold; -fx-text-fill: gray;" text="Next Appointment" />
         <Label fx:id="nextApptLabel" style="-fx-font-size: 16px;" text="Loading..." />
      </VBox>

      <Separator orientation="VERTICAL" prefHeight="40.0" prefWidth="0.0" />

      <VBox alignment="TOP_RIGHT">
         <Label style="-fx-font-weight: bold; -fx-text-fill: gray;" text="Overview" />
         <Label fx:id="totalApptsLabel" style="-fx-font-size: 16px;" text="0 Total Appointments" />
      </VBox>
   </HBox>

   <VBox spacing="10" VBox.vgrow="ALWAYS">
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Upcoming Schedule" />
      <ListView fx:id="appointmentListView" VBox.vgrow="ALWAYS" />
   </VBox>

   <padding>
      <Insets bottom="20" left="20" right="20" top="20" />
   </padding>

</VBox>
