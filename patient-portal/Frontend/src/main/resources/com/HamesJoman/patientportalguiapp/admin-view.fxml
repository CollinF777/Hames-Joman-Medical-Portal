<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="480.0" prefWidth="320.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.HamesJoman.patientportalguiapp.controllers.AdminControllers.AdminController">
    <top>
        <VBox alignment="CENTER" style="-fx-background-color: #f8f8f8; -fx-border-color: #dddddd; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="12" left="20" right="20" top="12" />
            </padding>
            <children>
                <Label text="Admin Dashboard" textFill="#309423">
                    <font>
                        <Font size="20.0" />
                    </font>
                </Label>
                <Label fx:id="actionText" textFill="#061083" wrapText="true">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>
    <center>
        <VBox alignment="TOP_CENTER" spacing="10">
            <padding>
                <Insets bottom="20" left="30" right="30" top="20" />
            </padding>
            <children>

                <Label text="Appointments" textFill="#555555">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
                <Button text="Search Appointments by Patient" onAction="#onPatientSearchAptButtonClick" maxWidth="Infinity" />
                <Button text="Search Appointments by Doctor" onAction="#onDoctorSearchAptButtonClick" maxWidth="Infinity" />
                <Button text="New Appointment" onAction="#onNewAptButtonClick" maxWidth="Infinity" />
                <Separator>
                    <VBox.margin>
                        <Insets top="5" bottom="5" />
                    </VBox.margin>
                </Separator>
                <Label text="Users" textFill="#555555">
                    <font>
                        <Font size="11.0" />
                    </font>
                </Label>
                <Button text="New User" onAction="#onNewUserButtonClick" maxWidth="Infinity" />
                <Button text="Update User" onAction="#onUpdateUserButtonClick" maxWidth="Infinity" />
                <Button text="Delete User" onAction="#onDeleteUserButtonClick" maxWidth="Infinity" />
            </children>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="15">
            <padding>
                <Insets bottom="20" left="30" right="30" top="10" />
            </padding>
            <children>
                <Button text="Log Out" onAction="#onLogoutButtonClick" prefWidth="120" />
                <Button text="Exit Application" onAction="#onExitButtonClick" prefWidth="130" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
