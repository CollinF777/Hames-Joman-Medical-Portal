<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="480.0" prefWidth="420.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.HamesJoman.patientportalguiapp.controllers.PatientControllers.CancelPatientAppointmentController">
    <padding>
        <Insets top="15.0" />
    </padding>
    <children>
        <Label text="Cancel Appointment" textFill="#309423">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <Label fx:id="actionText" textFill="#1b2e90" wrapText="true">
            <font>
                <Font size="13.0" />
            </font>
        </Label>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Label text="Select Appointment:">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <ComboBox fx:id="appointmentSelectComboBox" onAction="#onAppointmentSelected" prefWidth="240.0" />
            </children>
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
        </HBox>
        <Separator>
            <VBox.margin>
                <Insets bottom="5.0" left="20.0" right="20.0" top="15.0" />
            </VBox.margin>
        </Separator>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="backButton" onAction="#onBackButtonClick" text="Back" />
                <Region prefWidth="20.0" />
                <Button fx:id="cancelButton" onAction="#onCancelButtonClick" text="Cancel Appointment" />
            </children>
            <VBox.margin>
                <Insets top="25.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
