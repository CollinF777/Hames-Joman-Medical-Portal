<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="200.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.HamesJoman.patientportalguiapp.controllers.SharedControllers.ConfirmController">
    <padding>
        <Insets top="15.0" />
    </padding>
    <children>
        <Label text="Are you sure?" textFill="#309423">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="yesButton" onAction="#onYesButtonClick" text="Yes" />
                <Region prefWidth="20.0" />
                <Button fx:id="noButton" onAction="#onNoButtonClick" text="No" />
            </children>
            <VBox.margin>
                <Insets top="25.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
